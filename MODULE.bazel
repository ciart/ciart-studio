bazel_dep(name = "apple_support", version = "1.23.1", repo_name = "build_bazel_apple_support")
bazel_dep(name = "rules_cc", version = "0.2.8")
bazel_dep(name = "rules_swift", version = "3.1.2", repo_name = "build_bazel_rules_swift")
# bazel_dep(name = "rules_xcodeproj", version = "3.2.0")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_apple", version = "4.2.0", repo_name = "build_bazel_rules_apple")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "skia")
archive_override(
    module_name = "skia",
    url = "https://github.com/google/skia/archive/refs/heads/chrome/m142.tar.gz",
    strip_prefix = "skia-chrome-m142",
)
bazel_dep(name = "skia_user_config")
local_path_override(
    module_name = "skia_user_config",
    path = "custom_skia_config",
)
bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
    commit = "0e990032f3c5a866e72615cf67e5ce22186dcb97",
    # Replace the commit hash (above) with the latest (https://github.com/hedronvision/bazel-compile-commands-extractor/commits/main).
